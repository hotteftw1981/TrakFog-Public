# TrakFog · Docker Compose / Portainer
# Copy to .env for Docker Compose or enter the values in the Portainer Stack environment.
# NEVER commit real secrets.

TRAKFOG_HTTP_PORT=8780
TRAKFOG_TIMEZONE=Europe/Berlin
TRAKFOG_BASE_URL=https://trakfog.example.org

TRAKFOG_DB_NAME=trakfog
TRAKFOG_DB_USER=trakfog
TRAKFOG_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
TRAKFOG_DB_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD

# IMPORTANT FOR MIGRATING AN EXISTING TRAKFOG INSTALL:
# Copy the exact 'app_key' value from the old config/local.php.
# It looks like: base64:...
# If left empty on a fresh install, Docker generates and persists one automatically.
TRAKFOG_APP_KEY=

# Optional owner bootstrap for automated/headless installs.
# Leave EMAIL and PASSWORD empty to use the protected browser-based first-run wizard.
# The wizard requires a secret read locally from the web container; never share it.
# docker exec trakfog-web cat /var/lib/trakfog/setup_token
TRAKFOG_OWNER_USER=admin
TRAKFOG_OWNER_EMAIL=
TRAKFOG_OWNER_PASSWORD=

# Persistent worker polling. This does NOT intentionally wake an asleep Tesla.
TRAKFOG_WORKER_POLL_ONLINE_SECONDS=30
# Closed Tesla stream trips below this distance (meters) are discarded only with sufficient stationary evidence.
TRAKFOG_MIN_TRIP_DISTANCE_METERS=100
TRAKFOG_WORKER_POLL_SLEEP_SECONDS=60
TRAKFOG_WORKER_HEARTBEAT_SECONDS=15


# Reverse Geocoding for trip start/destination and charge locations.
# Runs only against coordinates already stored in TrakFog and never wakes the Tesla.
TRAKFOG_GEOCODER_ENABLED=1
TRAKFOG_GEOCODER_URL=https://nominatim.openstreetmap.org
TRAKFOG_GEOCODER_USER_AGENT=TrakFog self-hosted Tesla data platform


# Built-in one-click updater.
# Change only if the Docker Engine socket lives at another host path.
TRAKFOG_DOCKER_SOCKET=/var/run/docker.sock
