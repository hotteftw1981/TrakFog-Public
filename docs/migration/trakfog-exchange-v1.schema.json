{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrakFog Exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "vehicles",
    "trips",
    "positions",
    "charges"
  ],
  "properties": {
    "format": {
      "const": "trakfog-exchange"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "vin": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "trips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vehicle_source_id",
          "started_at"
        ],
        "properties": {
          "vehicle_source_id": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "distance_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vehicle_source_id",
          "recorded_at",
          "latitude",
          "longitude"
        ],
        "properties": {
          "vehicle_source_id": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "additionalProperties": true
      }
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vehicle_source_id",
          "started_at"
        ],
        "properties": {
          "vehicle_source_id": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "energy_added_kwh": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
